HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/costage.sqlite
# Set true behind HTTPS in production
COOKIE_SECURE=false
# Comma-separated browser origins. Local development defaults are enabled.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# A JSON array of RTCIceServer objects; use short-lived TURN credentials in production.
ICE_SERVERS=[]

# Public live video is relayed as HLS over HTTPS; ffmpeg is required.
MEDIA_TRANSPORT=hls
FFMPEG_PATH=ffmpeg
MAX_LIVE_STREAMS=4
MEDIA_PATH=./data/live
